# PlatformIO
.pio/

# Generated by scripts/copy_sketch.py — the real sketch lives in project root
src/*.ino

# Generated by tools/build_web.py — minified + gzipped www/ tree.  Source
# of truth is www/; this directory is regenerated on demand and uploaded
# to LittleFS via the SPA's /upload endpoint.
dist/

# Generated by tools/gzip_www.sh (legacy, superseded by tools/build_web.py)
www_gz/

# Python bytecode cache (e.g. tools/__pycache__/)
__pycache__/
*.pyc

# Arduino IDE build output (compiled firmware/bootloader binaries)
build/

# Stale firmware/bootloader artefacts at tools/ root — produced by CI,
# not source of truth (see tools/flash_bootloader/ for the Rust source).
tools/*.bin
tools/*.exe

# Rust target directory for the flash_bootloader crate
tools/flash_bootloader/target/

# Transient build log written by the node CI matrix
node/build.log

# Per-machine deploy tool settings: a port, and any baud someone pinned.
# Everything else it needs comes from platformio.ini (see tools/pio_envs.py).
.flash_tool.json

# Generated by the pioarduino platform when [env:x_core3_probe] builds with
# custom_sdkconfig: it materialises the resolved ESP-IDF config into the
# project root. ~110 KB of machine-written output per env, regenerated on
# every build — a build artifact, not a source of truth.
# Anchored to the project root on purpose: an unanchored `sdkconfig.*` matches
# at any depth and would swallow the TRACKED tools/bootloader/sdkconfig.defaults.*
# family, so a new board's bootloader config would be silently skipped by
# `git add`.
/sdkconfig.defaults
/sdkconfig.*

# Same build: the ESP-IDF component manager materialises Arduino's declared
# managed components into the project root (~174 MB of Zigbee, Matter,
# RainMaker, esp-dsp, esp-modbus — none of which this firmware uses; they are
# pulled in by the core's idf_component.yml, and stubbing them out is the
# prerequisite for CONFIG_LWIP_IPV6=n. See docs/CORE3_MIGRATION.md).
# .dummy/ is the placeholder component the platform generates alongside them.
/managed_components/
/.dummy/

# Generated by `pio run -t compiledb` for editors and clangd. It is a build
# artifact that rewrites itself on every build (3.3 MB of absolute paths from
# whichever machine ran it), so tracking it put churn in every diff and made
# the file the second-largest thing in the repository.
compile_commands.json
data/

# The Kindle dashboard writes its settings here, seeded from
# kindle/dash.conf.default on first run. It holds one person's collector
# address and refresh intervals — never the project's.
kindle/dash.conf
