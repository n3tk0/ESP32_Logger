# dash.conf — ESP32 Logger Kindle dashboard
#
# This file is the DEFAULT. On first run update_dash.sh copies it to
# dash.conf beside it, and only dash.conf is ever written to — so copying a
# new version of the extension over an old one cannot overwrite your settings.
#
# Edit it from the device: KUAL → ESP32 Dashboard → Settings. Editing this file
# by hand over USB or SSH works just as well; restart the dashboard afterwards.

# Collector address (IP or http://host:port)
HOST=192.168.1.50

# Seconds to wait for the collector
FETCH_TIMEOUT=10

# ── How often each part of the screen is redrawn, in minutes ────────────────
# E-ink ghosts, and the cure — a flashing refresh — is visible. So the clock,
# which changes every minute, is flashed inside its own small rectangle; the
# readings and the chart are redrawn without a flash; and once an hour the
# whole page is cleared and flashed, which resets ghosting everywhere.

# Minutes between clock updates
CLOCK_EVERY=1

# Minutes between sensor updates
DATA_EVERY=5

# Minutes between chart updates
GRAPH_EVERY=15

# Minutes between forecast updates. The collector polls the weather API on its
# own schedule (WebUI → Settings → Forecast → Fetch interval, 10–360 min);
# redrawing more often than that just redraws the same numbers.
FORECAST_EVERY=30

# Minutes between whole-screen refreshes
FULL_EVERY=60

# Flash the clock zone every N clock updates (0 = never). 1 keeps that corner
# permanently clean, which is where ghosting shows first.
CLOCK_FLASH_EVERY=1

# Flash the readings zone every N sensor updates (0 = never). Off by default:
# it is a third of the screen, and the hourly full refresh already clears it.
SENSOR_FLASH_EVERY=0

# Log every FBInk call to kual.log, beside these scripts (1 = on, 0 = off).
# Draws nothing differently — it only writes down what was drawn, which is the
# only way to tell a panel that drew the wrong thing from one that drew the
# right thing and had it come out wrong. A line per string, so leave it off
# unless something on screen needs explaining.
TRACE=0

# ── Battery ──────────────────────────────────────────────────────────────────
# awake   | what this always did: the CPU loops and the radio stays associated,
#           about 60-80 mA, which on a ten-year-old cell is a day and a half.
# wifi    | the radio is off except around a fetch. Roughly halves the draw,
#           and cannot fail in a way the panel does not already handle.
# suspend | the above, and the wait between ticks is a real suspend to RAM with
#           an RTC alarm to come back — under a milliamp while it is down.
#           This is the one that can leave the panel dark if the alarm does not
#           take, so the script reads the alarm back before it goes down and
#           falls back to an ordinary sleep if it did not stick. Try `wifi`
#           first, and `suspend` when you are ready to be near the device.
#
# AND `suspend` ON ITS OWN DOES NOT BUY DAYS. With CLOCK_EVERY=1 the panel
# suspends and comes back sixty times an hour, and every one of those is a
# resume, a draw and a flashing refresh of the clock. The saving is in not
# waking up: the panel now sleeps straight through the minutes with no tier due
# in them, so it is the intervals that decide how long it stays down. KUAL →
# Settings → Battery → "deep sleep, rare updates" sets both in one go.
POWER=awake

# Seconds to wait for the radio to associate before fetching anyway. Four to
# ten is normal for this chip and DHCP; the fetch is attempted either way.
WIFI_WAIT=15

# Stop the Amazon reader framework while the panel runs (1 = yes, 0 = no).
# Another 10-15 mA.
#
# READ THIS ONE BEFORE TURNING IT ON. KUAL is hosted BY the framework this
# stops, so while it is on there is no menu to press Stop in — the way back
# from every other setting here is the one thing this setting takes away. The
# ways back are: set this to 0 over USB, which the dashboard picks up within a
# minute like any other key; run stop.sh, which puts the framework back itself;
# or hold the power button until the Kindle reboots. On firmware where the
# framework also serves the radio, the dashboard notices the first time a fetch
# cannot turn it on, puts the framework back, and says so in the log.
GUI_STOP=0

# ── The screen the dashboard is drawn on ─────────────────────────────────────
#
# FBInk writes to the framebuffer; it does not own the screen. The reader's own
# framework does, and it repaints its library whenever it likes — which is what
# makes the dashboard vanish back to the home screen for a minute at a time,
# and what makes a tap on the dashboard open a book.
#
#   desktop   what this always did: drawn over whatever the reader is showing
#   blank     ask the framework to put its chrome away first
#
# `blank` is half the fix and costs nothing. The whole fix is GUI_STOP above,
# which stops the framework altogether — use the tap menu below to get back.
CANVAS=desktop

# ── The tap menu ─────────────────────────────────────────────────────────────
# Tap the screen and a bar appears along the bottom. Tap a button and it runs;
# tap anywhere above the bar and it goes away. Exit runs the same cleanup as
# Stop — and asks first, because a panel's touch calibration is the thing most
# likely to be wrong and Exit is the one button that cannot be undone from the
# sofa.
#
# ON BY DEFAULT. It is the way back from GUI_STOP, which takes the launcher and
# the Stop button with it, and it costs one process blocked in read(2).
#
# IT COMBINES WITH POWER=suspend NOW. While the CPU is down nothing reads the
# touchscreen, because nothing can — but the power button brings it back, and
# WAKE_MENU below is what makes the panel answer that with this bar instead of
# going straight back to sleep. 1 = on, 0 = off.
TOUCH=1

# Which input device is the touchscreen. Empty = find it (the one that reports
# absolute positions). Set it to /dev/input/eventN if that guess is wrong.
TOUCH_DEV=

# The touch panel's full scale, when it does not already report screen pixels.
# 0 = it does. Run with TRACE=1 and tap the corners: the log prints every touch
# raw and mapped, which is where these two numbers come from.
TOUCH_MAXX=0
TOUCH_MAXY=0

# 1 if the panel reports Y where X is expected.
TOUCH_SWAP=0

# ── What is on the bar ───────────────────────────────────────────────────────
# MENU_ACT is the list that decides: how many buttons the bar has, and what
# each one does. Two to five of these five words —
#
#   refresh    fetch everything and redraw the whole page now
#   wake       stop sleeping, so the device can be told things — and on the
#              second press, go back to sleeping. This is the button the power
#              button exists to reach: it writes POWER, so KUAL and the panel
#              agree about it afterwards
#   settings   a second bar: find the collector, step to the next one, cycle
#              the battery setting, show what the device thinks is going on.
#              With GUI_STOP=1 there is no KUAL, and this is the whole of the
#              settings menu, drawn where a finger can reach it
#   hide       put the bar away (tapping above it does the same)
#   quit       end the dashboard, after asking
#
# MENU_LBL only NAMES them, in whatever language you like, in the same order.
# The `wake` button is a toggle, so its label may carry BOTH directions with a
# slash between them — `Awake/Sleep` — and the bar draws the half that says
# which way the next tap will go. A label with no slash is used as it is.
# If it has fewer labels than MENU_ACT has buttons the built-in English is used
# instead — a bar whose words are one place along from its buttons is worse
# than a bar you cannot read.
MENU_LBL=Refresh|Awake/Sleep|More|Exit
MENU_ACT=refresh|wake|settings|quit

# The settings bar, in its fixed order: find, next, battery, info, back.
MENU_LBL2=Find|Next|Battery|Info|Back

# What the bar says while it is asking whether you meant Exit.
SURE_LBL=Tap the bar again to exit

# The three power modes, as the footer status line names them.
MODE_LBL=awake|radio off|asleep

# ── Waking it up ─────────────────────────────────────────────────────────────
# A SUSPENDED KINDLE WAKES FROM THE POWER BUTTON. Not from the touchscreen —
# its controller has no power while the CPU is down, which is the same reason a
# sleeping Kindle does not wake when you touch the screen. So the button is the
# way in, and until now the panel did not notice: it woke, found nothing due
# that minute, drew nothing, and went straight back down. The press worked
# perfectly and looked like a dead button.
#
# With WAKE_MENU=1 a press repaints the page and puts the bar up, and the panel
# stays awake and listening for WAKE_HOLD seconds — longer if you keep tapping.
# Then it goes back down by itself.
#
# TOUCH=0 with WAKE_MENU=1 is the combination worth having on a wall: nothing
# reads the touchscreen while nobody is there, and the button summons a menu
# when somebody is.
WAKE_MENU=1
WAKE_HOLD=120

# ── Quiet hours ──────────────────────────────────────────────────────────────
# A flashing refresh is a black frame, and at three in the morning in a bedroom
# it is the brightest thing in the room. It is also the most expensive thing
# this panel does, on the hours when nobody is reading it.
#
# Between these two hours nothing flashes and the clock is drawn every
# QUIET_EVERY minutes instead of CLOCK_EVERY — which, with POWER=suspend, is
# what turns the night into one long sleep rather than sixty short ones. The
# morning is paid for in one go: leaving the quiet hours spends a whole
# flashing refresh, which is where a night of partial updates goes.
#
# Hours, 0-23, and the two being equal turns it off. QUIET_EVERY=0 means the
# clock keeps its usual interval.
QUIET_FROM=0
QUIET_TO=0
QUIET_EVERY=15

# ── The footer status line ───────────────────────────────────────────────────
# The right-hand end of the footer: how full THIS Kindle is (the battery badge
# on the page belongs to the outdoor node), which power mode it is actually in
# — a panel inside its wake window is awake whatever POWER says — and, in
# brackets when the collector has stopped answering, the time it last did.
# 1 = on.
STATUS=1

# ── The first run ────────────────────────────────────────────────────────────
# When the first fetch fails against the address the package shipped, and no
# scan has ever been run, look for the collector on this subnet once and say
# what turned up. That is the first-run state rather than a fault, and the
# reader is standing in front of a device with no keyboard. 1 = on.
AUTO_FIND=1
